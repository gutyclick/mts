# Server-only catalog configuration. Both blank = bundled local catalog.
# Put actual values in .env.local or Vercel Environment Variables, never in Git.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_SITE_URL=https://www.mytripsim.com
# eSIM Access server credentials. Configure locally with npm run provider:configure.
ESIM_ACCESS_CODE=
ESIM_ACCESS_SECRET_KEY=
# Internal check endpoint token, generated by npm run provider:deploy-env.
ESIM_ACCESS_SYNC_SECRET=
# Local catalog import only. Test secret, never NEXT_PUBLIC. Configure with stripe:configure.
STRIPE_TEST_SECRET_KEY=
# Use a publishable key (sb_publishable_...), never a secret/service-role key.
# No secret key is needed for public catalog reads. See docs/supabase-setup.md.
