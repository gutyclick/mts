# Server-only catalog configuration. Both blank = bundled local catalog.
# Put actual values in .env.local or Vercel Environment Variables, never in Git.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_SITE_URL=https://www.mytripsim.com
# eSIM Access server credentials. Configure locally with npm run provider:configure.
ESIM_ACCESS_CODE=
ESIM_ACCESS_SECRET_KEY=
# Internal check endpoint token, generated by npm run provider:deploy-env.
ESIM_ACCESS_SYNC_SECRET=
# Local catalog import only. Test secret, never NEXT_PUBLIC. Configure with stripe:configure.
STRIPE_TEST_SECRET_KEY=
# Publishable test key: intentionally returned by /api/checkout/config for Stripe Elements.
STRIPE_TEST_PUBLISHABLE_KEY=
# Server-only test checkout. Never use NEXT_PUBLIC for any of these values.
SUPABASE_CHECKOUT_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_WEBHOOK_ID=
CHECKOUT_REQUEST_SECRET=
CHECKOUT_EXPIRY_SECRET=
CHECKOUT_SITE_URL=https://www.mytripsim.com
STRIPE_TEST_CHECKOUT_ENABLED=false
# Private eSIM delivery. Stripe test orders never provision unless explicitly authorized per unit by an operator.
FULFILLMENT_ENABLED=false
FULFILLMENT_LINK_SECRET=
RESEND_API_KEY=
# SIM assistant: server only. Configure with npm.cmd run support:configure.
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-5.4-mini-2026-03-17
SUPPORT_AI_ENABLED=false
SUPPORT_DAILY_CHAT_LIMIT=300
# Use a publishable key (sb_publishable_...), never a secret/service-role key.
# No secret key is needed for public catalog reads. See docs/supabase-setup.md.
