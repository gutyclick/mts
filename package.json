{
  "name": "mytripsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "import:catalog": "node scripts/import-catalog.mjs",
    "import:details": "node scripts/import-plan-details.mjs",
    "sync:images": "node scripts/sync-destination-images.mjs",
    "prebuild": "npm run sync:images",
    "predev": "npm run sync:images",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/catalog.test.ts tests/device-compatibility.test.ts tests/plan-details.test.mjs tests/cart.test.mjs",
    "test:e2e": "playwright test",
    "audit:ui": "node scripts/audit.mjs",
    "capture": "node scripts/capture.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "supabase:seed": "node --experimental-strip-types scripts/generate-supabase-seed.mjs",
    "supabase:check": "node --experimental-strip-types scripts/check-supabase.mjs",
    "test:supabase": "node --experimental-strip-types --test tests/supabase-catalog.test.mjs tests/customer-security.test.mjs",
    "test:supabase:web": "node --experimental-strip-types scripts/test-supabase-web.mjs",
    "test:accounts": "node scripts/test-customer-auth.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.14.0",
    "circle-flags": "^2.8.3",
    "csv-parse": "^7.0.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
